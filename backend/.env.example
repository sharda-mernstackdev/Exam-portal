# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/exam_portal

# Port the API server listens on
PORT=5000

# Secrets used to sign JWTs — change these to long random strings in production
JWT_SECRET=change_this_student_jwt_secret
ADMIN_JWT_SECRET=change_this_admin_jwt_secret

# How long tokens stay valid
JWT_EXPIRES_IN=6h

# Default admin account created by the seed script (npm run seed)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@pskexamportal.local

# Comma-separated list of origins allowed to call this API.
# Set this to wherever you serve the frontend HTML files from.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
